{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midwestcnc",
  "compatibility_date": "2026-05-26",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midwestcnc-leads",
      "database_id": "bf690c6e-eca6-4033-b1de-db5d375c5ffb"
    }
  ]
}
